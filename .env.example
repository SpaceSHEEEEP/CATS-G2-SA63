# Copy to .env for LOCAL development only; never commit filled-in values.
DB_NAME=cats
DB_USERNAME=cats_app
DB_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ANOTHER_STRONG_PASSWORD
# Generate: openssl rand -base64 32
MFA_ENCRYPTION_KEY=CHANGE_ME_32_RANDOM_BYTES_IN_BASE64
PUBLIC_BASE_URL=http://localhost:8080
SESSION_COOKIE_SECURE=false
APP_HTTP_PORT=8080
# First startup ONLY: supply credentials, start once, then turn off and remove values.
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
# Optional SMTP, required for actual notifications.
SMTP_HOST=
SMTP_PORT=587
ADMIN_MAIL_USERNAME=
ADMIN_MAIL_PASSWORD=
