# Copy to /opt/cats/.env.production on the server and chmod 600.
# Select the production database topology with this setting or an exported environment override.
DEPLOY_DB_MODE=external
# Keep credentials on the server. Never commit a populated environment file.
CATS_IMAGE=ghcr.io/owner/repo:commit-sha
DB_NAME=cats
DB_USERNAME=cats_app
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
# External mode: a reachable JDBC URL, preferably with verified DB TLS.
# Container mode: overridden to the private Compose network by compose.database.yml.
DB_URL=jdbc:mysql://db-host.example.internal:3306/cats?sslMode=VERIFY_IDENTITY
# Required only for container mode. Use a DIFFERENT strong root password.
MYSQL_ROOT_PASSWORD=
MFA_ENCRYPTION_KEY=REPLACE_WITH_BASE64_OF_32_RANDOM_BYTES
PUBLIC_BASE_URL=https://cats.example.org
CATS_HTTP_BIND_ADDRESS=127.0.0.1
CATS_HTTP_PORT=8080
SESSION_COOKIE_SECURE=true
MOBILE_CORS_ORIGINS=https://localhost,capacitor://localhost
ADMIN_MAIL_USERNAME=
ADMIN_MAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
