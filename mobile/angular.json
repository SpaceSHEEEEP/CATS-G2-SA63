{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cats-mobile": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cats",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/web",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [{"glob": "**/*", "input": "src/assets", "output": "/assets"}],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {"optimization": true, "outputHashing": "all", "budgets": [
              {"type": "initial", "maximumWarning": "900kB", "maximumError": "1.5MB"}
            ]},
            "development": {"optimization": false, "sourceMap": true, "outputHashing": "none"}
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {"buildTarget": "cats-mobile:build"},
          "configurations": {"development": {"buildTarget": "cats-mobile:build:development"}}
        }
      }
    }
  },
  "cli": {"analytics": false}
}
